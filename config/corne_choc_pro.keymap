#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/pointing.h>


&lt {
    tapping-term-ms = <150>; // This is the value already set by default
};

/ {
    chosen {
        zmk,physical-layout = &default_layout;
    };
};

/ {
    behaviors {
        sml: home_row_shift_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <100>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            // Right-hand positions in default_layout, including thumbs.
            hold-trigger-key-positions = <
                 7  8  9 10 11 12 13
                21 22 23 24 25 26 27
                   34 35 36 37 38 39
                   43 44 45
            >;
            hold-trigger-on-release;
        };
        cml: home_row_ctrl_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <
                7  8  9 10 11 12 13
                21 22 23 24 25 26 27
                34 35 36 37 38 39
                43 44 45
            >;
        };
        gml: home_row_gui_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <
                7  8  9 10 11 12 13
                21 22 23 24 25 26 27
                34 35 36 37 38 39
                43 44 45
            >;
        };

        smr: home_row_shift_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <100>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            // Left-hand positions in default_layout, including thumbs.
            hold-trigger-key-positions = <
                0  1  2  3  4  5  6
                14 15 16 17 18 19 20
                28 29 30 31 32 33
                40 41 42
            >;
            hold-trigger-on-release;
        };
        cmr: home_row_ctrl_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            // Left-hand positions in default_layout, including thumbs.
            hold-trigger-key-positions = <
                0  1  2  3  4  5  6
                14 15 16 17 18 19 20
                28 29 30 31 32 33
                40 41 42
            >;
            hold-trigger-on-release;
        };
        gmr: home_row_gui_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            // Left-hand positions in default_layout, including thumbs.
            hold-trigger-key-positions = <
                0  1  2  3  4  5  6
                14 15 16 17 18 19 20
                28 29 30 31 32 33
                40 41 42
            >;
            hold-trigger-on-release;
        };
    };

    macros {
        // Keep these unassigned behaviors available for selection in ZMK Studio.
        // Start scrolling on key press and stop on release.
        scroll_up: scroll_up {
            compatible = "zmk,behavior-macro";
            display-name = "Scroll Up";
            #binding-cells = <0>;
            wait-ms = <0>;
            bindings = <&macro_press &msc SCRL_UP>,
                       <&macro_pause_for_release>,
                       <&macro_release &msc SCRL_UP>;
        };

        scroll_down: scroll_down {
            compatible = "zmk,behavior-macro";
            display-name = "Scroll Down";
            #binding-cells = <0>;
            wait-ms = <0>;
            bindings = <&macro_press &msc SCRL_DOWN>,
                       <&macro_pause_for_release>,
                       <&macro_release &msc SCRL_DOWN>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            // ------------------------------------------------------------------------------------------------
            // |  TAB  |   Q   |   W   |   E    |   R    |   T   | MUTE  | PLAY  |   Y   |   U    |   I    |   O   |   P   |   ü   |
            // | CAPS  | GUI A | ALT S | CTRL D | SHFT F |   G   | LALT  | RALT  |   H   | SHFT J | CTRL K | ALT L | GUI ö |   ä   |
            // |   /   |   Z   |   X   |   C    |   V    |   B   |               |   N   |   M    |   ,    |   .   |   /   |   ß   |
            //                         |  LWR   |  SYM   |  RET  |               |  SPC  | BSPC   | RALT   |
            // Note: LBKT produces ü (Shift: Ü) with a German host keyboard layout.
            // CAPS taps Caps Lock and holds the NAV layer. Home-row holds are
            // A=GUI, S=ALT, D=CTRL, F=SHIFT and J=SHIFT, K=CTRL, L=ALT, ;=GUI.
            // Thumbs: LWR holds the NUMBER layer, SYM holds the SYMBOL layer.
            bindings = <
                &kp TAB     &kp Q       &kp W       &kp E         &kp R         &kp T   &kp C_MUTE    &kp C_PP &kp Y      &kp U         &kp I         &kp O       &kp P           &kp LBKT
                &lt 3 CAPS  &gml LGUI A &cml LALT S &cml LCTRL D  &sml LSHFT F  &kp G   &kp LALT      &kp RALT &kp H      &smr RSHFT J  &cmr RCTRL K  &cmr RALT L &gmr RGUI SEMI  &kp SQT
                &kp SLASH   &kp Z       &kp X       &kp C         &kp V         &kp B                          &kp N      &kp M         &kp COMMA     &kp DOT     &kp FSLH        &kp MINUS
                                                    &mo 1         &mo 2         &kp RET                        &kp SPACE  &kp BSPC      &kp RALT
            >;
            // Sensor order: left upper, left lower, right upper, right lower.
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_UP PG_DN &inc_dec_kp C_PREV C_NEXT &inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        lower_layer {
            display-name = "NUMBER";
            // -------------------------------------------------------------------------------------------------------------
            // |  TAB  |   1   |   2   |   3   |   4   |   5    |       |       | NONE  |   7   |   8   |   9   | NONE  | NONE  |
            // |  FUN  |  BT1  |  BT2  |  BT3  |  BT4  |  BT5   |       |       | NONE  |   4   |   5   |   6   |   .   |   ,   |
            // | SHFT  | BTCLR |  RGB  |  RST  | BOOT  | UNLOCK |               |   0   |   1   |   2   |   3   | NONE  | NONE  |
            //                         |       |       |        |               |       |       |       |
            // FUN holds the F Keys layer. NONE blocks the key on this layer.
            bindings = <
                &kp TAB   &kp N1       &kp N2          &kp N3       &kp N4       &kp N5         &trans  &trans  &none   &kp N7   &kp N8 &kp N9  &none   &none
                &mo 4     &bt BT_SEL 0 &bt BT_SEL 1    &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &trans  &trans  &none   &kp N4   &kp N5 &kp N6  &kp DOT &kp COMMA
                &kp LSHFT &bt BT_CLR   &rgb_ug RGB_TOG &sys_reset   &bootloader  &studio_unlock                 &kp N0  &kp N1   &kp N2 &kp N3  &none   &none
                                                       &trans       &trans       &trans                         &trans  &trans   &trans
            >;
        };

        raise_layer {
            display-name = "SYMBOL";
            // ------------------------------------------------------------------------------------------------------------
            // |  TAB  |   ^   |   @   |   #   |   $   |   %   | LCTRL | RCTRL |   !   |   {   |   "   |   `   |   }   |   *   |
            // | LCTRL |  HUD  |  HUI  |       |       |       | LALT  | RALT  |   |   |   (   |   '   |   #   |   )   |   +   |
            // | SHFT  |       |       |       |       |       |               |   <   |   [   |   =   |   &   |   ]   |   ~   |
            //                         |       |       |       |               |       |       |       |
            // HUD/HUI are RGB hue down/up.
            bindings = <
                &kp TAB   &kp CARET       &kp AT          &kp HASH &kp DLLR &kp PRCNT &kp LCTRL &kp RCTRL &kp EXCL  &kp LBRC  &kp DQT    &kp GRAVE &kp RBRC &kp STAR
                &kp LCTRL &rgb_ug RGB_HUD &rgb_ug RGB_HUI &trans   &trans   &trans    &kp LALT  &kp RALT  &kp PIPE  &kp LPAR  &kp SQT    &kp HASH  &kp RPAR &kp PLUS
                &kp LSHFT &trans          &trans          &trans   &trans   &trans                        &kp NUBS  &kp LBKT  &kp EQUAL  &kp AMPS  &kp RBKT &kp TILDE
                                                          &trans   &trans   &trans                        &trans    &trans   &trans
            >;
        };

        nav_layer {
            display-name = "NAV";
            // ------------------------------------------------------------------------------------------------------------
            // |       |       |       |       |       |       |       |       |       | HOME  |  ESC  |  END  | PG UP |       |
            // |       |       |       |       |       |       |       |       | LEFT  | DOWN  |  UP   | RIGHT | PG DN |       |
            // |       |       |       |       |       |       |               |       |       |       |       |       |       |
            //                         |       |       |       |               |       |  DEL  |       |
            // Only the right half binds keys; every other position stays transparent.
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans   &kp HOME &kp ESC &kp END   &kp PG_UP &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &kp LEFT &kp DOWN &kp UP  &kp RIGHT &kp PG_DN &trans
                &trans &trans &trans &trans &trans &trans               &trans   &trans   &trans  &trans    &trans    &trans
                                     &trans &trans &trans               &trans   &kp DEL  &trans       
            >;
        };

        f_layer {
            display-name = "F Keys";
            // ------------------------------------------------------------------------------------------------------------
            // |       |       |       |       |       |       |       |       |       |  F7   |  F8   |  F9   |  F10  |       |
            // |       |       |       |       |       |       |       |       |       |  F4   |  F5   |  F6   |  F11  |       |
            // |       |       |       |       |       |       |               |       |  F1   |  F2   |  F3   |  F12  |       |
            //                         |       |       |       |               |       |       |       |
            // Only the right half binds keys; every other position stays transparent.
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &kp F7 &kp F8 &kp F9 &kp F10 &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &kp F4 &kp F5 &kp F6 &kp F11 &trans
                &trans &trans &trans &trans &trans &trans               &trans &kp F1 &kp F2 &kp F3 &kp F12 &trans
                                     &trans &trans &trans               &trans &trans &trans       
            >;
        };

        extra_layer_3 {
            display-name = "EXTRA 3";
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans
                                     &trans &trans &trans               &trans &trans &trans       
            >;
        };

        extra_layer_4 {
            display-name = "EXTRA 4";
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans
                                     &trans &trans &trans               &trans &trans &trans       
            >;
        };

        extra_layer_5 {
            display-name = "EXTRA 5";
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans
                                     &trans &trans &trans               &trans &trans &trans       
            >;
        };

        extra_layer_6 {
            display-name = "EXTRA 6";
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans
                                     &trans &trans &trans               &trans &trans &trans       
            >;
        };
    };
};
